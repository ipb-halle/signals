<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="signalsDB" transaction-type="JTA">
        <description>Persistence unit for signals tool</description>

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>signalsDS</jta-data-source>
        <non-jta-data-source>signalsDSNonJTA</non-jta-data-source>

        <class>de.ipb_halle.inhouse.InhouseCompound</class>
        <class>de.ipb_halle.inhouse.InhouseCompoundSynonym</class>
        <class>de.ipb_halle.signals.attachment.Attachment</class>
        <class>de.ipb_halle.signals.attachment.AttachmentRevision</class>
        <class>de.ipb_halle.signals.attachment.AttachmentFile</class>
        <class>de.ipb_halle.signals.attribute.AttributeDefinition</class>
        <class>de.ipb_halle.signals.attribute.AttributeValue</class>
        <class>de.ipb_halle.signals.config.LocalConfig</class>
        <class>de.ipb_halle.signals.entity.EntityType</class>
        <class>de.ipb_halle.signals.entity.SignalsEntity</class>
        <class>de.ipb_halle.signals.entity.SignalsEntityChild</class>
        <class>de.ipb_halle.signals.field.FieldDefinition</class>
        <class>de.ipb_halle.signals.field.FieldMeasure</class>
        <class>de.ipb_halle.signals.field.FieldOption</class>
        <class>de.ipb_halle.signals.field.FieldType</class>
        <class>de.ipb_halle.signals.field.FieldValueEntity</class>
        <class>de.ipb_halle.signals.inventory.ContainerEntity</class>
        <class>de.ipb_halle.signals.inventory.ContainerTypeEntity</class>
        <class>de.ipb_halle.signals.inventory.ContainerTypeAttachment</class>
        <class>de.ipb_halle.signals.inventory.LocationEntity</class>
        <class>de.ipb_halle.signals.inventory.LocationTypeEntity</class>
        <class>de.ipb_halle.signals.material.MaterialEntity</class>
        <class>de.ipb_halle.signals.material.MaterialsLibrary</class>
        <class>de.ipb_halle.signals.users.Group</class>
        <class>de.ipb_halle.signals.users.GroupMembership</class>
        <class>de.ipb_halle.signals.users.Role</class>
        <class>de.ipb_halle.signals.users.RolePriv</class>
        <class>de.ipb_halle.signals.users.RolePrivDef</class>
        <class>de.ipb_halle.signals.users.UserEntity</class>
        <class>de.ipb_halle.signals.users.UserRole</class>

        <properties>

            <!-- extend hibernate dialect with json support -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.connection.driver_class" value="org.postgresql.Driver"/>

            <!-- Logging-->
           <!-- <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.use_sql_comments" value="true" /> -->
            <property name="hibernate.generate_statistics" value="true" />
            <property name="jakarta.transaction.timeout" value="300"/>

            <!-- <property name="hibernate.hbm2ddl.auto" value="validate"/> -->

            <property name="tomee.jpa.cdi" value="false"/>

        </properties>

    </persistence-unit>
</persistence>

