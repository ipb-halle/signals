<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="signalsDB" transaction-type="JTA">
        <description>Persistence unit for signals tool</description>

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>signalsDS</jta-data-source>
        <non-jta-data-source>signalsDSNonJTA</non-jta-data-source>

        <class>de.ipb_halle.signals.SignalsEntity</class>
        <class>de.ipb_halle.signals.location.Location</class>
        <class>de.ipb_halle.signals.location.LocationType</class>
        <class>de.ipb_halle.signals.material.MaterialsLibrary</class>

        <properties>

            <!-- extend hibernate dialect with json support -->
            <!-- <property name="hibernate.dialect" value="de.ipb_halle.lbac.util.hibernatePG.dialect.PostgreSQL94JsonDialect"/> -->

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.connection.driver_class" value="org.postgresql.Driver"/>

            <!-- <property name="hibernate.hbm2ddl.auto" value="validate"/> -->

            <property name="tomee.jpa.cdi" value="false"/>

        </properties>

    </persistence-unit>
</persistence> 

