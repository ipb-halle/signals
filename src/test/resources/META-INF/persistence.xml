<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="testDB" transaction-type="JTA">
        <description>Persistence unit for signals tool unit testing</description>

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>testDS</jta-data-source>
        <non-jta-data-source>testDSNonJTA</non-jta-data-source>

        <class>de.ipb_halle.signals.SignalsEntity</class>
        <class>de.ipb_halle.signals.location.Location</class>
        <class>de.ipb_halle.signals.location.LocationType</class>
        <class>de.ipb_halle.signals.material.MaterialsLibrary</class>

        <properties>

            <property name="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect"/>
            <property name="hibernate.connection.driver_class" value="org.hsqldb.jdbcDriver"/>

            <property name="javax.persistence.schema-generation.database.action" value="create"/>
            <property name="javax.persistence.schema-generation.create-script-source" value="schema.sql"/>

            <!-- <property name="javax.persistence.schema-generation.drop-script-source" value="drop.sql"/> -->
            <!-- <property name="javax.persistence.sql-load-script-source" value="data.sql"/> -->

            <!-- <property name="hibernate.hbm2ddl.auto" value="validate"/> -->

            <!-- allow SQL statements to span multiple lines -->
            <property name="hibernate.hbm2ddl.import_files_sql_extractor" value="org.hibernate.tool.hbm2ddl.MultipleLinesSqlCommandExtractor"/>

            <property name="tomee.jpa.cdi" value="false"/>

        </properties>

    </persistence-unit>
</persistence> 

