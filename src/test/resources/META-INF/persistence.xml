<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="signalsDB" transaction-type="JTA">
        <description>Persistence unit for signals tool</description>

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>testDS</jta-data-source>
        <non-jta-data-source>testDSNonJTA</non-jta-data-source>

        <class>de.ipb_halle.signals.SignalsEntity</class>
        <class>de.ipb_halle.signals.entity.Attachment</class>
        <class>de.ipb_halle.signals.entity.FieldDefinition</class>
        <class>de.ipb_halle.signals.entity.FieldMeasure</class>
        <class>de.ipb_halle.signals.entity.FieldOption</class>
        <class>de.ipb_halle.signals.inventory.ContainerEntity</class>
        <class>de.ipb_halle.signals.inventory.ContainerType</class>
        <class>de.ipb_halle.signals.inventory.ContainerTypeAttachment</class>
        <class>de.ipb_halle.signals.inventory.ContainerTypeFieldDefinition</class>
        <class>de.ipb_halle.signals.inventory.LocationEntity</class>
        <class>de.ipb_halle.signals.inventory.LocationType</class>
        <class>de.ipb_halle.signals.material.MaterialEntity</class>
        <class>de.ipb_halle.signals.material.MaterialsLibrary</class>
        <class>de.ipb_halle.signals.users.Group</class>
        <class>de.ipb_halle.signals.users.GroupMembership</class>
        <class>de.ipb_halle.signals.users.Role</class>
        <class>de.ipb_halle.signals.users.RolePriv</class>
        <class>de.ipb_halle.signals.users.RolePrivDef</class>
        <class>de.ipb_halle.signals.users.UserEntity</class>
        <class>de.ipb_halle.signals.users.UserRole</class>

        <properties>

            <!-- extend hibernate dialect with json support -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect"/>
<!--
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
-->
            <property name="hibernate.connection.driver_class" value="org.hsqldb.jdbcDriver"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="create-drop"/>
            <property name="jakarta.persistence.schema-generation.create-script-source" value="schema.sql"/>
            <property name="jakarta.persistence.schema-generation.drop-script-source" value="drop_schema.sql"/>
            <property name="hibernate.hbm2ddl.import_files_sql_extractor" value="org.hibernate.tool.schema.internal.script.MultiLineSqlScriptExtractor"/>
            <property name="tomee.jpa.cdi" value="false"/>

        </properties>

    </persistence-unit>
</persistence> 

